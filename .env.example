# ==============================================================================
# HƯỚNG DẪN BIẾN MÔI TRƯỜNG CHO VERCEL & MÁY CHỦ CỤC BỘ
# ==============================================================================

# 1. GEMINI_API_KEY (Bắt buộc cho các tính năng Trợ lý AI):
# Lấy API Key miễn phí từ Google AI Studio (https://aistudio.google.com/app/apikey).
# Khi triển khai lên Vercel: Thêm biến này vào phần "Environment Variables" trong Project Settings trên Vercel.
GEMINI_API_KEY="AIzaSyYourGeminiApiKeyHere"

# 2. PORT (Tùy chọn - Chỉ dùng khi chạy máy chủ cục bộ hoặc Docker độc lập):
# Mặc định là 3000. Trên Vercel, serverless runtime sẽ tự quản lý cổng.
PORT=3000

# 3. NODE_ENV (Môi trường thực thi):
# Vercel tự động đặt là "production" trong quá trình build và chạy.
NODE_ENV="development"
